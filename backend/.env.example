# IBM Equity Dashboard - Backend Configuration
# Copy this file to .env and update with your values

# Database
DATABASE_URL=sqlite:///./equity.db
DATABASE_ENCRYPTION_ENABLED=true

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Market Data
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_CACHE_TTL=300  # 5 minutes in seconds
MARKET_DATA_REFRESH_INTERVAL=300  # 5 minutes

# Tax Settings
DEFAULT_TAX_RATE=0.37  # 37% (22% federal supplemental + 15.3% FICA)

# CORS (for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Application
APP_NAME=IBM Equity Dashboard
APP_VERSION=0.1.0-mvp
ENVIRONMENT=development